            if (ganancia[i]<0)
            printf("\033[1;31m Ganancia: %.2f\033[0m\n", ganancia[i]);//rojo
            else
           printf("\033[1;33m Ganancia: %.2f\033[0m\n", ganancia[i]); //verde
    }
        //Muestra de libros existentes
        printf("\n Stock de libros \n");
        
        printf("\n%-25s %-20s %-30s %-12s %-8s %-6s %-10s\n",
