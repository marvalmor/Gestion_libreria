#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#define MAX_STRINGS 3
#define MAX_LENGT 20

 void toUppercase(char str []){
        for(int i=0; str[i]; i++){
            str[i]= toupper (str[i]);
    }
    }
    
 void buscarLibro(int cantidadLibros,
                 char titulo[][20],
                 char autor[][20],
                 char genero[][20],
                 char codigoISBN[][20],
                 int stock[],
                 float precioUnitario[]){
         
         char clave[20];
         int i,encontrado=0;

         printf("\nIngrese el titulo, autor, genero, o ISBN a buscar: \n");
         getchar(); //limpia el bufer
         fgets(clave, sizeof(clave), stdin); //fgets busca el maximo de caracteres iingresados
         toUppercase(clave);
         clave[strcspn(clave, "\n")]=0;

         for(i=0; i < cantidadLibros; i++){
                if (strstr(titulo[i], clave)|| strstr(autor[i], clave) ||
                strstr(genero[i], clave) || strstr(codigoISBN[i], clave)){

                    printf("\n Resultado: %s | %s | %s| %s | $%.2f USD | STOCK: %d\n",
                titulo[i], autor[i], genero[i], codigoISBN[i], (float)precioUnitario[i], stock[i]);
            encontrado = 1;
            break;
                }
         }
         if (!encontrado)
        printf("Libro no encontrado.\n");
     } 
     
int main(){

    // Declaración de array y asignacion de valor
  int cantidadLibros;
